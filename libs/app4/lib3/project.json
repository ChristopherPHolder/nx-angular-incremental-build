{
  "name": "app4-lib3",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/app4/lib3/src",
  "prefix": "app4l3",
  "projectType": "library",
  "tags": [
    "demo:entry-points",
    "scope:app4"
  ],
  "targets": {
    "build": {
      "executor": "@angular/build:library",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "tsConfig": "libs/app4/lib3/tsconfig.lib.json",
        "outputPath": "dist/libs/app4/lib3",
        "inlineStyleLanguage": "scss"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/app4/lib3/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "build-ng-packagr": {
      "executor": "@nx/angular:package",
      "outputs": [
        "{workspaceRoot}/dist/ng-packagr/{projectRoot}"
      ],
      "dependsOn": [
        "^build-ng-packagr"
      ],
      "options": {
        "project": "libs/app4/lib3/ng-package.json",
        "tsConfig": "libs/app4/lib3/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/app4/lib3/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    }
  }
}
